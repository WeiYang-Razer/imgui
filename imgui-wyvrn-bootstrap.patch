From fdd4af01e93bb421681c4f18a4247da6e6b49529 Mon Sep 17 00:00:00 2001
From: Wei Yang Tan <weiyang.tan@razer.com>
Date: Mon, 18 May 2026 15:15:48 +0800
Subject: [PATCH 5/9] Split backend option into platform + renderer
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

ImGui has two independent backend axes — windowing/input (platform)
and graphics API (renderer) — so collapsing them into one enum forced
a false choice (GLFW is not a renderer; DX12 is not a platform).

  - platform: win32 (default), glfw
  - renderer: directx12 (default), directx11, opengl, vulkan

Consumers pick one of each; the registry hashes the cross-product.
---
 wyvrn.json | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/wyvrn.json b/wyvrn.json
index b6482fe04..269ed17d7 100644
--- a/wyvrn.json
+++ b/wyvrn.json
@@ -9,9 +9,13 @@
       "default": true,
       "allowed": [true]
     },
-    "backend": {
+    "platform": {
+      "default": "win32",
+      "allowed": ["win32", "glfw"]
+    },
+    "renderer": {
       "default": "directx12",
-      "allowed": ["directx12", "directx11", "glfw", "opengl", "vulkan"]
+      "allowed": ["directx12", "directx11", "opengl", "vulkan"]
     }
   },
   "dependencies": {},
