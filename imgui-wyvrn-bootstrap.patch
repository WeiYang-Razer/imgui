From b74ac0732b07b53ecb604f24b298cac5a6765475 Mon Sep 17 00:00:00 2001
From: Wei Yang Tan <weiyang.tan@razer.com>
Date: Mon, 18 May 2026 15:27:54 +0800
Subject: [PATCH 8/9] Allow opting out of platform/renderer backend via "none"
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Adds "none" to the allowed set for both platform and renderer so a
consumer can disable either (or both) backend without falling back to
defaults. CMake normalises "none" to empty before the backend
dispatch, reusing the existing "no backend" path — keeps the
direct-cmake-without-wyvrn case identical.

Tested: configure+build clean for platform=none + renderer=none
(5 core sources only).
---
 CMakeLists.txt | 9 +++++++++
 wyvrn.json     | 4 ++--
 2 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 10aa1cb26..1fd091f38 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -33,6 +33,15 @@ set(IMGUI_RENDERER "" CACHE STRING "ImGui renderer backend (directx12, directx11
 set(IMGUI_BACKEND_HEADERS "")
 set(IMGUI_BACKEND_LIBS "")
 
+# Treat "none" as the explicit opt-out (same as empty), so consumers can
+# disable a backend via wyvrn options without dropping back to defaults.
+if(IMGUI_PLATFORM STREQUAL "none")
+    set(IMGUI_PLATFORM "")
+endif()
+if(IMGUI_RENDERER STREQUAL "none")
+    set(IMGUI_RENDERER "")
+endif()
+
 if(IMGUI_PLATFORM STREQUAL "glfw")
     list(APPEND IMGUI_SOURCES         backends/imgui_impl_glfw.cpp)
     list(APPEND IMGUI_BACKEND_HEADERS backends/imgui_impl_glfw.h)
diff --git a/wyvrn.json b/wyvrn.json
index 8cbb14daa..aeee7de42 100644
--- a/wyvrn.json
+++ b/wyvrn.json
@@ -11,11 +11,11 @@
     },
     "platform": {
       "default": "glfw",
-      "allowed": ["glfw", "win32"]
+      "allowed": ["glfw", "win32", "none"]
     },
     "renderer": {
       "default": "directx12",
-      "allowed": ["directx12", "directx11", "opengl", "vulkan"]
+      "allowed": ["directx12", "directx11", "opengl", "vulkan", "none"]
     }
   },
   "dependencies": {},
-- 
